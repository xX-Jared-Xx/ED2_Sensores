<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MenuActivity">

    <LinearLayout
        android:id="@+id/mainbg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:orientation="vertical"
        android:gravity="center"
        >

        <TextView
            android:id="@+id/tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ED2. Uso de Funcionalidades"
            android:textSize="25sp"
            >

        </TextView>

        <View
            android:layout_marginVertical="50dp"
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <Button
            android:id="@+id/btnGravedad"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Sensor de Gravedad"
            >

        </Button>
        <Button
            android:id="@+id/btnMagnetismo"
            android:layout_marginTop="30dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Sensor de Magnetismo"
            >

        </Button>

        <View
            android:layout_marginVertical="50dp"
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hernandez Delgado Angel Eden"
            android:textSize="15sp"
            android:layout_marginTop="10dp"
            >

        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Martinez Castro Elias Jared"
            android:textSize="15sp"
            android:layout_marginTop="10dp"
            >
        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiburcio Campusano Gabriel"
            android:textSize="15sp"
            android:layout_marginTop="10dp"
            >



        </TextView>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>